# CertFlow Environment Variables
# Copy this file to .env and adjust values

# PostgreSQL connection string
DATABASE_URL=postgres://zentra:zentra@localhost:5432/zentra?sslmode=disable

# JWT signing secret (change in production!)
JWT_SECRET=certflow-dev-secret-change-in-production

# API server port
PORT=8080

# Frontend API URL (used by Next.js at build time)
NEXT_PUBLIC_API_URL=http://localhost:8080
